#!/bin/sh
set -eu
repo_root="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoLogo -NoProfile -File "$repo_root/tools/check-public-tree.ps1"
fi
if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$repo_root/tools/check-public-tree.ps1"
fi
echo "PUBLIC_TREE_GATE: PowerShell 7 or Windows PowerShell is required." >&2
exit 1
